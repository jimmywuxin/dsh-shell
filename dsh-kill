#!/bin/bash
# dsh-kill：停止 dsh web 服务（dsh-restart 的只停版，不重启）。
# 服务由 launchd 托管（KeepAlive=true），pkill 会被原地复活 → 必须先 bootout。
# bootout 只影响本会话，下次登录仍自动加载；恢复靠从 plist 重新 bootstrap。
# 进程匹配必须用真实 argv（bin.js --profile web）；"dsh web" 子串一个都匹配不到。
# 停止判据 = 无匹配进程 + 端口无响应，只探端口会被非 dsh 占用者骗过。
# 强杀会带走持锁进程，收尾必须清一次失效锁，否则下次启动撞 writer lock 超时。
# 沿革见 CHANGELOG.md。
set -u

# PATH 由 dsh-lib.sh 统一补（含 /opt/homebrew/bin，与 build.sh 的 node 候选一致）

LIB="$HOME/.dsh/lib/dsh-lib.sh"
if [ ! -f "$LIB" ]; then
  echo "缺少 $LIB，请重新运行 build.sh" >&2
  exit 1
fi
# shellcheck source=../src/dsh-lib.sh
. "$LIB"

port_responds() { curl -s -o /dev/null --noproxy '*' --max-time 1 "$URL"; }
dsh_pids() { pgrep -f "$PROC_PATTERN" 2>/dev/null; }

# 停了 = 匹配进程已无（强杀后仍可能短暂在，pgrep 空为准）+ 端口已释放。
stopped() { [ -z "$(dsh_pids)" ] && ! port_responds; }

# 轮询到停：$1=轮数（每轮 0.5s），$2=完成话术。
# 2026-10-06：这段循环原本在下面出现了 4 次（bootout / 强杀 / pkill / 再强杀）。
wait_stop() {
  local n="$1" i
  for ((i = 0; i < n; i++)); do
    stopped && finish "$2"
    sleep 0.5
  done
  return 0
}

finish() {
  reap_stale_lock
  echo "dsh web 已停止（$1；恢复用 dsh-restart 或双击 dsh.app）"
  exit 0
}

# 两条路径共用的收尾：软停没成就强杀，仍不停就带上现场信息失败退出。
force_stop_or_die() {
  echo "进程未退出，尝试强制终止…" >&2
  pkill -9 -f "$PROC_PATTERN" 2>/dev/null
  wait_stop 10 "强制终止"
  echo "dsh web 停止失败：进程仍在（$(dsh_pids | tr '\n' ' ')），或端口 ${URL##*:} 被其他进程占用（$(lsof -nP -iTCP:"${URL##*:}" -sTCP:LISTEN 2>/dev/null | awk 'NR>1{print $1}' | sort -u | tr '\n' ' ')）。查看 $HOME/.dsh/web.err.log" >&2
  exit 1
}

if launchd_managed; then
  # --- launchd 托管：bootout ---
  if launchctl bootout "$DOMAIN/$LABEL"; then
    echo "dsh web 卸载指令已发出（launchctl bootout），等待停止…"
    wait_stop 30 "launchd: bootout —— 服务已从 launchd 卸载，本会话内不会自启"
    force_stop_or_die
  fi
  echo "launchctl bootout 失败，退回 pkill 路径…" >&2
else
  echo "未检测到 launchd 服务 ${LABEL}，走 pkill…"
fi

# --- 未托管 / bootout 失败：pkill 路径 ---
if pkill -f "$PROC_PATTERN" 2>/dev/null; then
  echo "dsh web 终止信号已发出，等待停止…"
else
  echo "dsh web 未在运行（无匹配进程）"
fi

wait_stop 30 "已停止"
force_stop_or_die