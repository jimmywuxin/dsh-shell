#!/bin/bash
# dsh-restart：重启 dsh web 服务（launchd 感知）。
# 服务由 launchd 托管（KeepAlive=true）：pkill 会被原地复活，再手起一个就是双实例抢 3080。
# 路径：kickstart -k → 未装载则从 plist bootstrap → 仍托管却重启不了就报错退出。
# 就绪判据看 HTTP 状态码，不能只看端口连通（半启动态 bind 3080 但返 404）。
# kickstart -k 是强杀，动作前必须 reap_stale_lock，否则下一实例撞 writer lock 崩溃循环。
# 判据/常量/锁处理来自 dsh-lib.sh；两级失败后必须先问 launchd_managed，不接管健康实例。
# 沿革见 CHANGELOG.md。
set -u

# PATH 由 dsh-lib.sh 统一补（含 /opt/homebrew/bin，与 build.sh 的 node 候选一致）

LIB="$HOME/.dsh/lib/dsh-lib.sh"
if [ ! -f "$LIB" ]; then
  echo "缺少 $LIB，请重新运行 build.sh" >&2
  exit 1
fi
# shellcheck source=../src/dsh-lib.sh
. "$LIB"

die_logged() { echo "$1" >&2; tail -20 "$LOG_DIR/web.err.log" >&2; exit 1; }

# --- 1) launchd 托管：kickstart -k ---
OLD_PID="$(pid_of)"

# 重启动作前清掉上一轮遗留的失效锁，避免 kickstart 直接撞进崩溃循环（注 3）
reap_stale_lock

if launchd_managed; then
  if launchctl kickstart -k "$DOMAIN/$LABEL"; then
    # 等「PID 已换 + 应用真就绪」；只看端口会误判（注 2）
    for _i in $(seq 1 60); do
      NEW_PID="$(pid_of)"
      if [ -n "$NEW_PID" ] && [ "$NEW_PID" != "$OLD_PID" ] && app_ready; then
        echo "dsh web 已重启（launchd kickstart，pid ${OLD_PID:-?} -> ${NEW_PID}，HTTP $(probe_code)）"
        exit 0
      fi
      sleep 0.5
    done
    die_logged "dsh web 重启超时（launchd kickstart），最近错误："
  fi
  echo "launchctl kickstart 失败，尝试 bootstrap plist…" >&2
fi

# --- 2) 服务未装载（典型：刚跑过 dsh-kill）→ 从 plist 重新 bootstrap ---
#     bootstrap 成功即回到 launchd 托管态，绝不手起脱离 KeepAlive 的野实例。
if [ -f "$PLIST" ]; then
  if launchctl bootstrap "$DOMAIN" "$PLIST" 2>/dev/null; then
    if CODE="$(wait_ready)"; then
      echo "dsh web 已重启（launchd bootstrap 重新装载，pid $(pid_of)，HTTP $CODE）"
      exit 0
    fi
    die_logged "bootstrap 后 30s 未就绪（launchd），最近错误："
  fi
  echo "launchctl bootstrap 失败。" >&2
fi

# --- 3) 仍受 launchd 托管 → 不接管 ---
#     kickstart 瞬时失败但 label 还在（例如 bootout 刚结束的残留态）时，
#     杀进程 + 手起会毁掉健康实例。宁可失败也不破坏托管。
if launchd_managed; then
  STATE="$(launchctl print "$DOMAIN/$LABEL" 2>/dev/null | awk -F'= ' '/state = /{print $2; exit}')"
  printf '%s\n' "服务仍在 launchd 托管下（state = ${STATE:-?}），但无法重启。" \
                "  若确认要重来：dsh-kill（bootout 卸载）→ dsh-restart（bootstrap 装载）。" >&2
  die_logged "  最近错误："
fi

# --- 4) 确认未托管且两条路都不通 → 交回 launchd，不手起 ---
# 手起实例脱离 KeepAlive，还会被 wrapper 的 free_port 当孤儿杀掉。
# 沙箱内 bootstrap 必失败（error 5），真终端跑或重启电脑（RunAtLoad）即可恢复。
echo "launchd 未托管且无法 bootstrap，请在真终端执行：" >&2
echo "  launchctl bootstrap $DOMAIN $PLIST" >&2
echo "  或重启电脑（登录时 RunAtLoad 自动装载）。" >&2
exit 1